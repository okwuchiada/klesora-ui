{
  "name": "button",
  "title": "Button",
  "element": "kl-button",
  "class": "kl-btn",
  "description": "Triggers an action. The element itself is the button; inside a form it submits or resets.",
  "attributes": [
    {
      "name": "variant",
      "type": "'solid' | 'secondary' | 'outline' | 'ghost' | 'danger' | 'link'",
      "default": "solid",
      "data": "data-variant"
    },
    {
      "name": "size",
      "type": "'sm' | 'md' | 'lg'",
      "default": "md",
      "data": "data-size"
    },
    {
      "name": "icon",
      "type": "boolean",
      "description": "Square, icon-only. Give it an aria-label.",
      "data": "data-icon"
    },
    {
      "name": "loading",
      "type": "boolean",
      "description": "Shows a spinner, sets aria-busy and ignores activation.",
      "data": "data-loading"
    },
    {
      "name": "disabled",
      "type": "boolean"
    },
    {
      "name": "type",
      "type": "'submit' | 'reset' | 'button'",
      "default": "submit"
    },
    {
      "name": "popovertarget",
      "type": "string",
      "description": "Id of a popover to toggle, like on <button>."
    },
    {
      "name": "popovertargetaction",
      "type": "'toggle' | 'show' | 'hide'",
      "default": "toggle"
    }
  ],
  "events": [
    {
      "name": "click",
      "native": true
    }
  ],
  "tokens": [
    "--kl-btn-radius",
    "--kl-btn-font-weight",
    "--kl-btn-font-size",
    "--kl-btn-gap",
    "--kl-btn-press-scale",
    "--kl-btn-ripple"
  ],
  "examples": [
    {
      "title": "Variants",
      "html": "<kl-button>Pay</kl-button>\n<kl-button variant=\"secondary\">Save</kl-button>\n<kl-button variant=\"outline\">Cancel</kl-button>\n<kl-button variant=\"danger\">Delete</kl-button>"
    },
    {
      "title": "Class layer",
      "html": "<button class=\"kl-btn\" data-variant=\"outline\" data-size=\"sm\">Cancel</button>\n<a class=\"kl-btn\" href=\"#statements\">Statements</a>"
    }
  ],
  "notes": [
    "For links use <a class=\"kl-btn\">.",
    "Submit buttons don't send their own name/value (custom elements can't be submitters)."
  ]
}
