{
  "name": "klesora-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Zero-dependency UI component library in plain HTML, CSS and JS, with three switchable styles: Solo, Mono and Chorus.",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Adanma Okwuchi",
  "keywords": [
    "ui",
    "components",
    "web-components",
    "design-system",
    "css",
    "framework-agnostic"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./css": "./src/klesora-ui.css",
    "./css/*": "./src/css/*.css",
    "./tokens/*": "./src/tokens/*.css",
    "./styles/*": "./src/styles/*.css",
    "./core/*": {
      "types": "./types/src/core/*.d.ts",
      "default": "./src/core/*.js"
    },
    "./components/*.css": "./src/components/*/*.css",
    "./components/*": {
      "types": "./types/src/components/*/*.d.ts",
      "default": "./src/components/*/*.js"
    },
    "./directives/*": {
      "types": "./types/src/directives/*.d.ts",
      "default": "./src/directives/*.js"
    },
    "./services/*": {
      "types": "./types/src/services/*.d.ts",
      "default": "./src/services/*.js"
    },
    "./types/react": {
      "types": "./types/react.d.ts"
    },
    "./types/vue": {
      "types": "./types/vue.d.ts"
    },
    "./types/svelte": {
      "types": "./types/svelte.d.ts"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "CONVENTIONS.md",
    "SECURITY.md",
    "types",
    "custom-elements.json",
    "FRAMEWORKS.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/index.js",
    "./src/components/**/*.js",
    "./src/directives/**/*.js"
  ],
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "gen:palette": "node scripts/gen-palette.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "playwright test",
    "build:types": "rm -rf types && tsc -p tsconfig.build.json && node scripts/build-manifest.mjs",
    "check:types": "node scripts/build-manifest.mjs --check && tsc -p types-test/tsconfig.json",
    "build:docs": "node scripts/build-docs.mjs",
    "docs": "node scripts/build-docs.mjs --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okwuchiada/klesora-ui.git"
  },
  "homepage": "https://klesora-ui.vercel.app/",
  "bugs": {
    "url": "https://github.com/okwuchiada/klesora-ui/issues"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "svelte": "^5.57.2",
    "typescript": "^7.0.2",
    "vue": "^3.5.44"
  },
  "types": "./types/index.d.ts",
  "customElements": "custom-elements.json"
}
