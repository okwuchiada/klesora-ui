{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:docs",
  "outputDirectory": "site",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/lib/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
