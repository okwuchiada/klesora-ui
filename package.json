{
  "name": "klesora-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Zero-dependency UI component library in plain HTML, CSS and JS, with three switchable styles: Solo, Mono and Chorus.",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Adanma Okwuchi",
  "keywords": [
    "ui",
    "components",
    "web-components",
    "design-system",
    "css",
    "framework-agnostic"
  ],
  "exports": {
    ".": "./src/index.js",
    "./css": "./src/klesora-ui.css",
    "./tokens/*": "./src/tokens/*.css",
    "./styles/*": "./src/styles/*.css",
    "./components/*": "./src/components/*/*.js",
    "./components/*.css": "./src/components/*/*.css",
    "./directives/*": "./src/directives/*.js",
    "./services/*": "./src/services/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "CONVENTIONS.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/index.js",
    "./src/components/**/*.js",
    "./src/directives/**/*.js"
  ],
  "scripts": {
    "dev": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okwuchiada/klesora-ui.git"
  },
  "homepage": "https://klesora-ui.vercel.app/",
  "bugs": {
    "url": "https://github.com/okwuchiada/klesora-ui/issues"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2"
  }
}
